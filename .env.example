# CoinDCX API Credentials
# Get your API key and Secret from https://coindcx.com/profile (API Management)
COINDCX_API_KEY=your_coindcx_api_key_here
COINDCX_API_SECRET=your_coindcx_api_secret_here

# Trading Mode: "paper" (simulation) or "live" (real funds)
TRADING_MODE=paper

# Initial Simulated INR Capital
INITIAL_CAPITAL=1000.0

# LLM API Key (Optional: for enhanced conversational reasoning)
# GEMINI_API_KEY=your_gemini_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here
